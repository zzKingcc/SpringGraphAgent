<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>com.zxc</groupId>
    <artifactId>springAI-rag</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>springAI-rag (Stringer)</name>
    <description>Java-based AI Workflow Orchestration Starter - 多模块聚合工程</description>

    <modules>
        <module>stringer-core</module>
        <module>stringer-common</module>
        <module>stringer-retrieval</module>
        <module>stringer-infrastructure</module>
        <module>stringer-capability</module>
        <module>stringer-agent</module>
        <module>stringer-server</module>
        <module>stringer-spring-boot-starter</module>
        <module>stringer-example</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <stringer.version>1.0-SNAPSHOT</stringer.version>
        <langchain4j.version>1.18.1</langchain4j.version>
        <langgraph4j.version>1.8.17</langgraph4j.version>
        <elasticsearch.version>9.4.4</elasticsearch.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- LangChain4j BOM -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- LangGraph4j BOM -->
            <dependency>
                <groupId>org.bsc.langgraph4j</groupId>
                <artifactId>langgraph4j-bom</artifactId>
                <version>${langgraph4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 强制锁定 ES 客户端版本（langchain4j-bom 解析的版本与 ES 服务器 9.4.4 不一致） -->
            <dependency>
                <groupId>co.elastic.clients</groupId>
                <artifactId>elasticsearch-java</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>
            <dependency>
                <groupId>org.elasticsearch.client</groupId>
                <artifactId>elasticsearch-rest-client</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>

            <!-- ===== 内部模块版本管理 ===== -->
            <dependency>
                <groupId>com.zxc</groupId>
                <artifactId>stringer-core</artifactId>
                <version>${stringer.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zxc</groupId>
                <artifactId>stringer-common</artifactId>
                <version>${stringer.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zxc</groupId>
                <artifactId>stringer-retrieval</artifactId>
                <version>${stringer.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zxc</groupId>
                <artifactId>stringer-infrastructure</artifactId>
                <version>${stringer.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zxc</groupId>
                <artifactId>stringer-capability</artifactId>
                <version>${stringer.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zxc</groupId>
                <artifactId>stringer-agent</artifactId>
                <version>${stringer.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zxc</groupId>
                <artifactId>stringer-server</artifactId>
                <version>${stringer.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zxc</groupId>
                <artifactId>stringer-spring-boot-starter</artifactId>
                <version>${stringer.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zxc</groupId>
                <artifactId>stringer-example</artifactId>
                <version>${stringer.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
