<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zxc</groupId>
        <artifactId>springAI-rag</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>stringer-agent</artifactId>
    <name>stringer-agent</name>
    <description>Stringer Agent 运行时：接口层 / 图编排 / 工具体系 / 任务停止</description>

    <dependencies>
        <dependency>
            <groupId>com.zxc</groupId>
            <artifactId>stringer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zxc</groupId>
            <artifactId>stringer-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zxc</groupId>
            <artifactId>stringer-capability</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zxc</groupId>
            <artifactId>stringer-infrastructure</artifactId>
        </dependency>

        <!-- LangChain4j 核心（消息、工具、模型接口） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
        </dependency>

        <!-- LangGraph4j 图编排 -->
        <dependency>
            <groupId>org.bsc.langgraph4j</groupId>
            <artifactId>langgraph4j-core</artifactId>
        </dependency>

        <!-- Reactor 流式输出 -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <!-- Spring Web（Controller + 全局异常处理） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <!-- spring-webmvc 对 servlet-api 是 provided 作用域，编译期需显式声明 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>
</project>
