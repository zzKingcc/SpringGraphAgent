<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zxc</groupId>
        <artifactId>Stringer</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>stringer-server</artifactId>
    <name>stringer-server</name>
    <description>Stringer 中心平台/可运行服务：配置装配 + 启动类 + 全部运行资源</description>

    <dependencies>
        <dependency>
            <groupId>com.zxc</groupId>
            <artifactId>stringer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zxc</groupId>
            <artifactId>stringer-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zxc</groupId>
            <artifactId>stringer-retrieval</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zxc</groupId>
            <artifactId>stringer-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zxc</groupId>
            <artifactId>stringer-capability</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zxc</groupId>
            <artifactId>stringer-agent</artifactId>
        </dependency>

        <!-- Spring Boot Web + AOP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- LangChain4j 集成（OpenAI 兼容模型 + Spring Starter + EasyRAG） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-reactor</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-easy-rag</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-elasticsearch</artifactId>
        </dependency>

        <!-- LangGraph4j 集成（ChatMessage/ToolExecutionRequest 序列化器） -->
        <dependency>
            <groupId>org.bsc.langgraph4j</groupId>
            <artifactId>langgraph4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bsc.langgraph4j</groupId>
            <artifactId>langgraph4j-langchain4j</artifactId>
        </dependency>

        <!-- 强制锁定 ES 客户端版本 -->
        <dependency>
            <groupId>co.elastic.clients</groupId>
            <artifactId>elasticsearch-java</artifactId>
        </dependency>
        <dependency>
            <groupId>org.elasticsearch.client</groupId>
            <artifactId>elasticsearch-rest-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.zxc.stringer.server.SpringRagApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
